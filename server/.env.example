PORT=8080
NODE_ENV=production
# Required in production. Make each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
MASTER_KEY=
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=
REGULATOR_CODE=
# The public https address of the site
PUBLIC_URL=https://alma.example.com
FORCE_HTTPS=1
TRUST_PROXY=1
# Require two-step sign-in for these roles
REQUIRE_2FA=owner,regulator
# Only set these to 1 for a trial on one machine
ALLOW_LOCAL_CHAIN=
ALLOW_LOCAL_STORAGE=

# Supabase production persistence. Apply server/supabase/migrations/*.sql first.
# Set the Project URL and service role secret in this server's environment only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email for claim codes, for example smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Alma <no-reply@alma.example.com>

# Backups
BACKUP_EVERY_MIN=360
BACKUP_KEEP=14
BACKUP_DIR=
DATA_DIR=./data
UTC_OFFSET_HOURS=3

# Blockchain. Leave CHAIN_RPC empty to use the built-in local chain.
CHAIN_RPC=
OWNER_PRIVATE_KEY=
FUND_WEI=1000000000000000000
GAS_PRICE_GWEI=30
NATIVE_USD=0.5

# IPFS. Leave IPFS_API empty to keep blocks in local folders. Otherwise list your Kubo nodes.
IPFS_API=
IPFS_GATEWAY=https://ipfs.io/ipfs/
NODES=Nairobi,Mombasa,Kisumu
MAX_FILE_KB=500

# Anchor the audit log on the chain every this many blocks
ANCHOR_EVERY=20

# Paper registry assumptions used in the performance test
LEGACY_FEE_USD=25
LEGACY_DAYS=5
LEGACY_PER_HOUR=4
